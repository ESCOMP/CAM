physics/cam1/ramp.h
physics/cam1/{ramp_ghg_bau.h,ramp_ghg_stab.h}
physics/cam1/crdcon.h
physics/cam1/radini.F90
physics/cam1/{radcswmx.F90,trcpth.F90}
physics/cam1/advnce.F90
